### rivers (lengths in km) #####################################################
dbr:Rhine  dbo:crosses dbr:Germany , dbr:Switzerland , dbr:Netherlands , dbr:France ;
           dbo:length 1233 .
dbr:Danube dbo:crosses dbr:Germany , dbr:Austria , dbr:Hungary ;
           dbo:length 2850 .
dbr:Elbe   dbo:crosses dbr:Germany , dbr:Czech_Republic ;
           dbo:length 1094 .
dbr:Seine  dbo:crosses dbr:France ;
           dbo:length 775 .
dbr:Nile   dbo:crosses dbr:Egypt , dbr:Sudan ;
           dbo:length 6650 .
dbr:Po_River dbo:crosses dbr:Italy ;
           dbo:length 652 .

