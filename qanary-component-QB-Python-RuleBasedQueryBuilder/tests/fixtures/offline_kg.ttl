# Offline knowledge graph for the E2E tests of the rule-based query builder.
#
# DBpedia-style URIs and predicates; the facts are a small, controlled subset
# (values simplified) chosen so that every question in questions.json has a
# well-defined answer and exactly one matching graph pattern. The tests execute
# the generated SPARQL queries against this graph — fully offline.
@prefix dbr: <http://dbpedia.org/resource/> .
@prefix dbo: <http://dbpedia.org/ontology/> .

### countries ##################################################################
dbr:Germany        dbo:capital dbr:Berlin ;   dbo:currency dbr:Euro ;
                   dbo:officialLanguage dbr:German_language ;
                   dbo:leader dbr:Frank-Walter_Steinmeier .
dbr:France         dbo:capital dbr:Paris ;    dbo:currency dbr:Euro ;
                   dbo:officialLanguage dbr:French_language ;
                   dbo:leader dbr:Emmanuel_Macron .
dbr:Spain          dbo:capital dbr:Madrid ;   dbo:currency dbr:Euro ;
                   dbo:officialLanguage dbr:Spanish_language .
dbr:Italy          dbo:capital dbr:Rome ;     dbo:currency dbr:Euro ;
                   dbo:officialLanguage dbr:Italian_language .
dbr:Austria        dbo:capital dbr:Vienna ;   dbo:currency dbr:Euro ;
                   dbo:officialLanguage dbr:German_language .
dbr:Switzerland    dbo:capital dbr:Bern ;     dbo:currency dbr:Swiss_franc ;
                   dbo:officialLanguage dbr:German_language , dbr:French_language ,
                                        dbr:Italian_language , dbr:Romansh_language .
dbr:Netherlands    dbo:capital dbr:Amsterdam ; dbo:currency dbr:Euro ;
                   dbo:officialLanguage dbr:Dutch_language .
dbr:Poland         dbo:capital dbr:Warsaw ;   dbo:currency dbr:Polish_zloty ;
                   dbo:officialLanguage dbr:Polish_language .
dbr:Japan          dbo:capital dbr:Tokyo ;    dbo:currency dbr:Japanese_yen ;
                   dbo:officialLanguage dbr:Japanese_language .
dbr:Canada         dbo:capital dbr:Ottawa ;   dbo:currency dbr:Canadian_dollar ;
                   dbo:officialLanguage dbr:English_language , dbr:French_language .
dbr:Brazil         dbo:capital dbr:Brasilia ; dbo:currency dbr:Brazilian_real ;
                   dbo:officialLanguage dbr:Portuguese_language .
dbr:India          dbo:capital dbr:New_Delhi ; dbo:currency dbr:Indian_rupee ;
                   dbo:officialLanguage dbr:Hindi , dbr:English_language .
dbr:Egypt          dbo:capital dbr:Cairo ;    dbo:currency dbr:Egyptian_pound ;
                   dbo:officialLanguage dbr:Arabic_language .
dbr:Sudan          dbo:capital dbr:Khartoum ;
                   dbo:officialLanguage dbr:Arabic_language .
dbr:United_Kingdom dbo:capital dbr:London ;   dbo:currency dbr:Pound_sterling ;
                   dbo:officialLanguage dbr:English_language .
dbr:Hungary        dbo:capital dbr:Budapest ; dbo:currency dbr:Hungarian_forint .
dbr:Czech_Republic dbo:capital dbr:Prague ;   dbo:currency dbr:Czech_koruna .
dbr:United_States  dbo:capital dbr:Washington_DC ;
                   dbo:currency dbr:United_States_dollar .
dbr:Australia      dbo:capital dbr:Canberra ; dbo:currency dbr:Australian_dollar .

